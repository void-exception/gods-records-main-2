package com.God.sRecords.one.repository;

import com.God.sRecords.one.model.Task;
import com.God.sRecords.one.model.TypeTask;
import com.God.sRecords.one.regestration.model.User;
import com.God.sRecords.one.regestration.repository.UserRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.orm.jpa.DataJpaTest;
import org.springframework.test.context.ActiveProfiles;

import java.util.List;

import static org.assertj.core.api.Assertions.assertThat;

@DataJpaTest
@ActiveProfiles("test")
class TaskRepositoryTest {

    @Autowired
    private TaskRepository taskRepository;

    @Autowired
    private UserRepository userRepository;

    private User user;
    private User other;

    @BeforeEach
    void setUp() {
        user = userRepository.save(new User("Иван", "ivan@mail.com", "x"));
        other = userRepository.save(new User("Пётр", "petr@mail.com", "x"));

        Task t1 = new Task("A", "bodyA", user);
        Task t2 = new Task("B", "bodyB", user);
        t2.setType(TypeTask.TRASH);
        Task t3 = new Task("C", "bodyC", other);

        taskRepository.saveAll(List.of(t1, t2, t3));
    }

    @Test
    @DisplayName("findByUserId — возвращает только задачи пользователя")
    void findByUserId_shouldFilterByUser() {
        List<Task> tasks = taskRepository.findByUserId(user.getId());

        assertThat(tasks).hasSize(2)
                .extracting(Task::getName)
                .containsExactlyInAnyOrder("A", "B");
    }

    @Test
    @DisplayName("findByUserIdAndType — фильтрует по типу")
    void findByUserIdAndType_shouldFilter() {
        List<Task> trash = taskRepository.findByUserIdAndType(user.getId(), TypeTask.TRASH);

        assertThat(trash).hasSize(1)
                .extracting(Task::getName)
                .containsExactly("B");
    }

    @Test
    @DisplayName("deleteByUserIdAndType — удаляет только задачи указанного типа пользователя")
    void deleteByUserIdAndType_shouldDelete() {
        int deleted = taskRepository.deleteByUserIdAndType(user.getId(), TypeTask.TRASH);

        assertThat(deleted).isEqualTo(1);
        assertThat(taskRepository.findByUserId(user.getId())).hasSize(1);
        assertThat(taskRepository.findByUserId(other.getId())).hasSize(1);
    }
}
