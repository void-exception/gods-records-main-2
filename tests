package com.God.sRecords.one.service;

import com.God.sRecords.one.model.Task;
import com.God.sRecords.one.model.TypeTask;
import com.God.sRecords.one.regestration.model.User;
import com.God.sRecords.one.repository.TaskRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import java.util.List;
import java.util.Optional;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class TaskServiceTest {

    @Mock
    private TaskRepository taskRepository;

    @InjectMocks
    private TaskService taskService;

    private User user;
    private User otherUser;
    private Task task;

    @BeforeEach
    void setUp() {
        user = new User("Иван", "ivan@mail.com", "encoded");
        user.setId(1L);

        otherUser = new User("Пётр", "petr@mail.com", "encoded");
        otherUser.setId(2L);

        task = new Task("Тест", "Описание", user);
        task.setId(10L);
    }

    @Test
    @DisplayName("createTask — сохраняет задачу с типом NORMAL и привязанным пользователем")
    void createTask_shouldSaveTaskWithUser() {
        when(taskRepository.save(any(Task.class))).thenAnswer(inv -> inv.getArgument(0));

        taskService.createTask("Заголовок", "Тело", user);

        verify(taskRepository, times(1)).save(any(Task.class));
    }

    @Test
    @DisplayName("updateTask — обновляет поля, если задача принадлежит пользователю")
    void updateTask_shouldUpdateFields_whenOwnerMatches() {
        when(taskRepository.findById(10L)).thenReturn(Optional.of(task));

        taskService.updateTask(10L, "Новое имя", "Новое тело", TypeTask.ARCHIVED, user);

        assertThat(task.getName()).isEqualTo("Новое имя");
        assertThat(task.getBody()).isEqualTo("Новое тело");
        assertThat(task.getType()).isEqualTo(TypeTask.ARCHIVED);
        verify(taskRepository).save(task);
    }

    @Test
    @DisplayName("updateTask — не обновляет, если задача принадлежит другому пользователю")
    void updateTask_shouldNotUpdate_whenOwnerDiffers() {
        when(taskRepository.findById(10L)).thenReturn(Optional.of(task));

        taskService.updateTask(10L, "Хак", "Хак", TypeTask.TRASH, otherUser);

        assertThat(task.getName()).isEqualTo("Тест");
        assertThat(task.getType()).isEqualTo(TypeTask.NORMAL);
        verify(taskRepository, never()).save(any());
    }

    @Test
    @DisplayName("updateTask — бросает исключение, если задача не найдена")
    void updateTask_shouldThrow_whenTaskMissing() {
        when(taskRepository.findById(99L)).thenReturn(Optional.empty());

        assertThatThrownBy(() ->
                taskService.updateTask(99L, "x", "y", TypeTask.NORMAL, user))
                .isInstanceOf(java.util.NoSuchElementException.class);
    }

    @Test
    @DisplayName("deleteTask — удаляет только задачи типа TRASH текущего пользователя")
    void deleteTask_shouldCallRepositoryWithTrashType() {
        taskService.deleteTask(user);

        verify(taskRepository).deleteByUserIdAndType(1L, TypeTask.TRASH);
    }

    @Test
    @DisplayName("allTask — возвращает список задач пользователя")
    void allTask_shouldReturnUserTasks() {
        when(taskRepository.findByUserId(1L)).thenReturn(List.of(task));

        List<Task> result = taskService.allTask(user);

        assertThat(result).hasSize(1).containsExactly(task);
    }

    @Test
    @DisplayName("currrentTask — возвращает задачу, если она принадлежит пользователю")
    void currrentTask_shouldReturnTask_whenOwnerMatches() {
        when(taskRepository.findById(10L)).thenReturn(Optional.of(task));

        Optional<Task> result = taskService.currrentTask(10L, user);

        assertThat(result).isPresent();
    }

    @Test
    @DisplayName("currrentTask — пусто, если задача чужого пользователя")
    void currrentTask_shouldReturnEmpty_whenOwnerDiffers() {
        when(taskRepository.findById(10L)).thenReturn(Optional.of(task));

        Optional<Task> result = taskService.currrentTask(10L, otherUser);

        assertThat(result).isEmpty();
    }

    @Test
    @DisplayName("tasksType — фильтрация по типу")
    void tasksType_shouldFilterByType() {
        when(taskRepository.findByUserIdAndType(1L, TypeTask.ARCHIVED))
                .thenReturn(List.of(task));

        List<Task> result = taskService.tasksType(user, TypeTask.ARCHIVED);

        assertThat(result).hasSize(1);
        verify(taskRepository).findByUserIdAndType(1L, TypeTask.ARCHIVED);
    }
}
